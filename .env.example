# Copy to .env (never commit .env)
DATABASE_URL=postgres://josh:josh@localhost:5432/josh
# Local dev admin bootstrap (created on empty DB at API boot)
ADMIN_EMAIL=admin@josh.local
ADMIN_PASSWORD=change-me-min-8-chars
