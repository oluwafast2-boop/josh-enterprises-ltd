BETTER_AUTH_URL=http://localhost:4000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_LISTINGS=josh-listings
R2_BUCKET_PRIVATE=josh-private
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=local-dev-key
WEB_PORT=3000
API_PORT=4000
